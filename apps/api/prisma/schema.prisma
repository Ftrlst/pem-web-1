generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  STAFF
  SELLER
  OWNER
  ADMIN
}

enum ProductMovementType {
  IN
  OUT
  ADJUSTMENT
  DAMAGE
  EXPIRED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  PACKED
  READY_DELIVERY
  READY_PICKUP
  COMPLETED
  CANCELLED
  EXPIRED
}

enum PaymentMethod {
  TRANSFER
  QRIS
  EWALLET
  COD
}

enum PaymentStatus {
  UNPAID
  PENDING
  PAID
  FAILED
  EXPIRED
  REFUNDED
}

enum FulfillmentMethod {
  DELIVERY
  PICKUP
}

enum ReservationStatus {
  ACTIVE
  CONSUMED
  RELEASED
  EXPIRED
}

enum OutboxStatus {
  PENDING
  PROCESSING
  PUBLISHED
  FAILED
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum JournalStatus {
  POSTED
  REVERSED
}

enum ChatSenderType {
  CUSTOMER
  SELLER
  STAFF
  OWNER
  BOT
}

model Outlet {
  id             String          @id @default(uuid()) @db.Char(36)
  name           String
  slug           String          @unique
  timezone       String          @default("Asia/Jakarta")
  createdAt      DateTime        @default(now()) @db.DateTime(3)
  updatedAt      DateTime        @updatedAt @db.DateTime(3)
  users          User[]
  products       Product[]
  orders         Order[]
  payments       Payment[]
  stockMovements StockMovement[]
  chatRooms      ChatRoom[]
}

model User {
  id              String               @id @default(uuid()) @db.Char(36)
  outletId        String?              @db.Char(36)
  name            String
  email           String               @unique
  phone           String?
  passwordHash    String
  role            UserRole             @default(CUSTOMER)
  isActive        Boolean              @default(true)
  createdAt       DateTime             @default(now()) @db.DateTime(3)
  updatedAt       DateTime             @updatedAt @db.DateTime(3)
  outlet          Outlet?              @relation(fields: [outletId], references: [id], onDelete: SetNull)
  orders          Order[]
  createdProducts Product[]            @relation("ProductCreator")
  stockMovements  StockMovement[]      @relation("StockMovementActor")
  statusChanges   OrderStatusHistory[] @relation("StatusChanger")
  customerRooms   ChatRoom[]           @relation("CustomerRooms")
  sellerRooms     ChatRoom[]           @relation("SellerRooms")
  chatMessages    ChatMessage[]
  refreshTokens   RefreshToken[]

  @@index([outletId, role])
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Char(36)
  userId    String    @db.Char(36)
  tokenHash String    @unique
  familyId  String
  expiresAt DateTime  @db.DateTime(3)
  revokedAt DateTime? @db.DateTime(3)
  createdAt DateTime  @default(now()) @db.DateTime(3)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([familyId])
}

model Product {
  id             String                 @id @default(uuid()) @db.Char(36)
  outletId       String                 @db.Char(36)
  createdById    String?                @db.Char(36)
  name           String
  category       String
  priceIdr       BigInt
  stock          Int                    @default(0)
  reservedStock  Int                    @default(0)
  minStock       Int                    @default(5)
  description    String?
  imageUrl       String?
  isActive       Boolean                @default(true)
  createdAt      DateTime               @default(now()) @db.DateTime(3)
  updatedAt      DateTime               @updatedAt @db.DateTime(3)
  outlet         Outlet                 @relation(fields: [outletId], references: [id], onDelete: Cascade)
  createdBy      User?                  @relation("ProductCreator", fields: [createdById], references: [id], onDelete: SetNull)
  orderItems     OrderItem[]
  reservations   InventoryReservation[]
  stockMovements StockMovement[]

  @@unique([outletId, name])
  @@index([outletId, isActive])
  @@index([outletId, category])
  @@index([outletId, stock])
}

model Order {
  id                String                 @id @default(uuid()) @db.Char(36)
  outletId          String                 @db.Char(36)
  userId            String?                @db.Char(36)
  orderNumber       String                 @unique
  idempotencyKey    String?
  status            OrderStatus            @default(PENDING)
  paymentMethod     PaymentMethod
  fulfillmentMethod FulfillmentMethod
  customerName      String
  customerPhone     String?
  deliveryAddress   String?
  pickupLocation    String?
  scheduledDate     DateTime               @db.Date
  subtotalIdr       BigInt
  shippingIdr       BigInt                 @default(0)
  totalIdr          BigInt
  customerNote      String?
  trackingTokenHash String?
  createdAt         DateTime               @default(now()) @db.DateTime(3)
  updatedAt         DateTime               @updatedAt @db.DateTime(3)
  outlet            Outlet                 @relation(fields: [outletId], references: [id], onDelete: Restrict)
  user              User?                  @relation(fields: [userId], references: [id], onDelete: SetNull)
  items             OrderItem[]
  payments          Payment[]
  reservations      InventoryReservation[]
  statusHistory     OrderStatusHistory[]

  @@unique([outletId, idempotencyKey])
  @@index([outletId, status, createdAt])
  @@index([userId, createdAt])
  @@index([idempotencyKey])
  @@index([trackingTokenHash])
}

model OrderItem {
  id           String  @id @default(uuid()) @db.Char(36)
  orderId      String  @db.Char(36)
  productId    String  @db.Char(36)
  productName  String
  quantity     Int
  unitPriceIdr BigInt
  subtotalIdr  BigInt
  order        Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product      Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([productId])
}

model OrderStatusHistory {
  id          String       @id @default(uuid()) @db.Char(36)
  orderId     String       @db.Char(36)
  fromStatus  OrderStatus?
  toStatus    OrderStatus
  changedById String?      @db.Char(36)
  note        String?
  createdAt   DateTime     @default(now()) @db.DateTime(3)
  order       Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  changedBy   User?        @relation("StatusChanger", fields: [changedById], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
}

model InventoryReservation {
  id         String            @id @default(uuid()) @db.Char(36)
  orderId    String            @db.Char(36)
  productId  String            @db.Char(36)
  quantity   Int
  status     ReservationStatus @default(ACTIVE)
  expiresAt  DateTime          @db.DateTime(3)
  createdAt  DateTime          @default(now()) @db.DateTime(3)
  releasedAt DateTime?         @db.DateTime(3)
  order      Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product    Product           @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([orderId, productId])
  @@index([productId, status, expiresAt])
}

model StockMovement {
  id            String              @id @default(uuid()) @db.Char(36)
  outletId      String              @db.Char(36)
  productId     String              @db.Char(36)
  createdById   String?             @db.Char(36)
  type          ProductMovementType
  quantity      Int
  stockBefore   Int
  stockAfter    Int
  reason        String
  referenceType String?
  referenceId   String?
  createdAt     DateTime            @default(now()) @db.DateTime(3)
  outlet        Outlet              @relation(fields: [outletId], references: [id], onDelete: Restrict)
  product       Product             @relation(fields: [productId], references: [id], onDelete: Restrict)
  createdBy     User?               @relation("StockMovementActor", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([productId, createdAt])
  @@index([outletId, createdAt])
}

model Payment {
  id                    String        @id @default(uuid()) @db.Char(36)
  outletId              String        @db.Char(36)
  orderId               String        @db.Char(36)
  provider              String        @default("MANUAL")
  providerTransactionId String?
  idempotencyKey        String?
  method                PaymentMethod
  amountIdr             BigInt
  status                PaymentStatus @default(UNPAID)
  paidAt                DateTime?     @db.DateTime(3)
  metadata              Json?
  createdAt             DateTime      @default(now()) @db.DateTime(3)
  updatedAt             DateTime      @updatedAt @db.DateTime(3)
  outlet                Outlet        @relation(fields: [outletId], references: [id], onDelete: Restrict)
  order                 Order         @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@unique([provider, providerTransactionId])
  @@unique([orderId, idempotencyKey])
  @@index([orderId, status])
  @@index([idempotencyKey])
}

model WebhookEvent {
  id          String    @id @default(uuid()) @db.Char(36)
  provider    String
  eventId     String
  payloadHash String
  status      String    @default("RECEIVED")
  error       String?
  receivedAt  DateTime  @default(now()) @db.DateTime(3)
  processedAt DateTime? @db.DateTime(3)

  @@unique([provider, eventId])
  @@index([status, receivedAt])
}

model OutboxEvent {
  id            String       @id @default(uuid()) @db.Char(36)
  aggregateType String
  aggregateId   String       @db.Char(36)
  eventType     String
  payload       Json
  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0)
  availableAt   DateTime     @default(now()) @db.DateTime(3)
  publishedAt   DateTime?    @db.DateTime(3)
  lastError     String?
  createdAt     DateTime     @default(now()) @db.DateTime(3)

  @@index([status, availableAt])
  @@index([aggregateType, aggregateId])
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Char(36)
  outletId   String?  @db.Char(36)
  actorId    String?  @db.Char(36)
  action     String
  entityType String
  entityId   String
  oldValue   Json?
  newValue   Json?
  requestId  String?
  ipAddress  String?
  createdAt  DateTime @default(now()) @db.DateTime(3)

  @@index([entityType, entityId, createdAt])
  @@index([outletId, createdAt])
  @@index([actorId, createdAt])
}

model ChatRoom {
  id            String        @id @default(uuid()) @db.Char(36)
  outletId      String        @db.Char(36)
  customerId    String?       @db.Char(36)
  sellerId      String?       @db.Char(36)
  orderId       String?       @db.Char(36)
  lastMessageAt DateTime?     @db.DateTime(3)
  createdAt     DateTime      @default(now()) @db.DateTime(3)
  outlet        Outlet        @relation(fields: [outletId], references: [id], onDelete: Cascade)
  customer      User?         @relation("CustomerRooms", fields: [customerId], references: [id], onDelete: SetNull)
  seller        User?         @relation("SellerRooms", fields: [sellerId], references: [id], onDelete: SetNull)
  messages      ChatMessage[]

  @@index([outletId, lastMessageAt])
  @@index([customerId])
  @@index([sellerId])
}

model ChatMessage {
  id            String         @id @default(uuid()) @db.Char(36)
  roomId        String         @db.Char(36)
  senderId      String?        @db.Char(36)
  senderType    ChatSenderType
  message       String
  attachmentUrl String?
  isRead        Boolean        @default(false)
  createdAt     DateTime       @default(now()) @db.DateTime(3)
  room          ChatRoom       @relation(fields: [roomId], references: [id], onDelete: Cascade)
  sender        User?          @relation(fields: [senderId], references: [id], onDelete: SetNull)

  @@index([roomId, createdAt])
}

model ChartOfAccount {
  id        String        @id @default(uuid()) @db.Char(36)
  code      String        @unique
  name      String
  type      AccountType
  category  String?
  isActive  Boolean       @default(true)
  createdAt DateTime      @default(now()) @db.DateTime(3)
  lines     JournalLine[]
}

model JournalEntry {
  id              String        @id @default(uuid()) @db.Char(36)
  entryNumber     String        @unique
  entryDate       DateTime      @db.Date
  description     String
  referenceId     String?
  referenceType   String?
  status          JournalStatus @default(POSTED)
  reversedEntryId String?       @unique @db.Char(36)
  createdAt       DateTime      @default(now()) @db.DateTime(3)
  reversedEntry   JournalEntry? @relation("JournalReversal", fields: [reversedEntryId], references: [id], onDelete: Restrict)
  originalEntry   JournalEntry? @relation("JournalReversal")
  lines           JournalLine[]

  @@unique([referenceType, referenceId])
  @@index([entryDate, status])
  @@index([referenceId, referenceType])
}

model JournalLine {
  id             String         @id @default(uuid()) @db.Char(36)
  journalEntryId String         @db.Char(36)
  accountId      String         @db.Char(36)
  accountCode    String
  debitIdr       BigInt         @default(0)
  creditIdr      BigInt         @default(0)
  journalEntry   JournalEntry   @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  account        ChartOfAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([journalEntryId])
  @@index([accountId])
}
