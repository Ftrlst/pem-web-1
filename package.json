{
  "name": "kletak-kletik-snack",
  "version": "0.1.0",
  "private": true,
  "description": "Kletak-Kletik Snack - platform operasional UMKM snack",
  "packageManager": "pnpm@12.6.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently --names api,web --prefix-colors blue,magenta \"pnpm --filter @kletak/api dev\" \"pnpm --filter @kletak/web dev\"",
    "build": "pnpm --filter @kletak/contracts build && pnpm --filter @kletak/api build && pnpm --filter @kletak/web build",
    "typecheck": "pnpm --filter @kletak/contracts typecheck && pnpm --filter @kletak/api typecheck && pnpm --filter @kletak/web typecheck",
    "test": "pnpm --filter @kletak/contracts test && pnpm --filter @kletak/api test && pnpm --filter @kletak/web test",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @kletak/api prisma:generate",
    "db:migrate": "pnpm --filter @kletak/api prisma:migrate",
    "db:migrate:deploy": "pnpm --filter @kletak/api prisma:migrate:deploy",
    "db:seed": "pnpm --filter @kletak/api prisma:seed"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "prettier": "^3.5.3",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=22.14.0"
  },
