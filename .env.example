# Runtime
NODE_ENV=development
API_PORT=4000
WEB_PORT=3000
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# PostgreSQL
POSTGRES_DB=kletak
POSTGRES_USER=kletak
POSTGRES_PASSWORD=change-me-local-only
DATABASE_URL=postgresql://kletak:change-me-local-only@localhost:5432/kletak?schema=public
# TEST_DATABASE_URL=postgresql://kletak:change-me-local-only@localhost:5432/kletak_test?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# Auth (generate with: openssl rand -base64 48)
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-a-different-random-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_SECURE=false

# Payment adapters (leave empty for manual/transfer mode)
PAYMENT_PROVIDER=manual
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_WEBHOOK_SECRET=
XENDIT_SECRET_KEY=
XENDIT_WEBHOOK_SECRET=

# Seed demo (wajib jika NODE_ENV=production)
# SEED_DEMO_PASSWORD=replace-with-a-long-random-password

# Observability
SENTRY_DSN=
LOG_LEVEL=info
